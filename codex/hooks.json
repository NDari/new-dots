{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^mcp__.*github.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/git_read_only.py\"",
            "timeout": 5,
            "statusMessage": "Checking personal Git/GitHub policy"
          }
        ]
      }
    ]
  }
}
